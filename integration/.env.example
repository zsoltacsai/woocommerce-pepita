# Integration environment pins. These are the only versions the harness
# provisions; changing them is an explicit, reviewable decision.
WORDPRESS_IMAGE=wordpress:7.1.4-php8.5-apache
WORDPRESS_CLI_IMAGE=wordpress:cli-2.12.0-php8.5
MYSQL_IMAGE=mysql:8.4.13
WOOCOMMERCE_VERSION=11.3.0

# Test-only credentials. Never reuse these outside this isolated stack.
MYSQL_ROOT_PASSWORD=wps_it_root
MYSQL_PASSWORD=wps_it_password
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=wps-it-admin-password
WORDPRESS_ADMIN_EMAIL=admin@example.test

# Host ports. 8080 = HPOS store, 8081 = legacy order storage store.
HPOS_PORT=8080
LEGACY_PORT=8081

# Fixed secrets so the HTTP tests can authenticate without scraping the admin.
WPS_FEED_TOKEN=it-feed-token-0123456789abcdef0123456789abcdef
WPS_ORDER_API_KEY=it-order-key-0123456789abcdef0123456789abcdef
